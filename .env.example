# Contoh konfigurasi environment TenangCek.
# Salin ke .env.local lalu isi nilainya. Jangan commit file berisi nilai asli.

# Supabase — aman dipakai di client (anon key dilindungi RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Supabase baru juga menyediakan "publishable key"; boleh dipakai
# menggantikan anon key di variabel yang sama.

# HANYA di server. Dibutuhkan untuk DELETE /api/account/delete.
# Jangan pernah memakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — hanya dipakai di server (Route Handler).
GEMINI_API_KEY=

# Prisma (server-only). Ambil dari Supabase: Project Settings → Database.
# DATABASE_URL  : dipakai aplikasi (boleh lewat pooler, port 6543).
# DIRECT_URL    : dipakai Prisma CLI (db pull/studio); koneksi langsung, port 5432.
DATABASE_URL=
DIRECT_URL=
